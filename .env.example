# =============================================================================
# Voicerely Dashboard — Environment Configuration Template
# =============================================================================
# Copy this file to `.env.local` and fill in real values for your deployment.
# `.env*` is git-ignored, so your real secrets will NEVER be committed.
#
#   cp .env.example .env.local
#
# -----------------------------------------------------------------------------
# SECURITY MODEL (how these variables are used)
# -----------------------------------------------------------------------------
# Every variable below is read ONLY inside `lib/retell/client.ts`, which is a
# SERVER-ONLY module. The Retell API key and all tenant config are resolved
# there and used to call Retell's API from the Next.js server.
#
# The three API route handlers (app/api/calls, app/api/calls/[callId],
# app/api/billing/summary) are the ONLY consumers of that module. They proxy
# Retell, run the data through the transform layer (lib/transform.ts), and
# return ONLY the client-safe VoicerelyCallView shape. The raw Retell payload
# and any Retell-native cost/pricing fields are dropped server-side and never
# reach the browser bundle.
#
# => The RETELL_API_KEY is never exposed to the client. It exists only in the
#    Node.js server process / deployment secret store.
#
# If RETELL_API_KEY is left blank, the server runs in DEMO MODE: it serves
# deterministic synthetic call data so the UI is fully navigable without a
# live backend. Set a real key to switch to the live Retell proxy path.
# =============================================================================

# --- Retell backend (server-only, never sent to the browser) ---------------
# Global fallback key used when no per-tenant key is configured below.
RETELL_API_KEY=

# Optional per-tenant override. The clientId is resolved from the
# `x-client-id` request header (or "default" if absent). Variable name is
# derived as: RETELL_API_KEY_<CLIENT_ID_UPPERCASE>
# RETELL_API_KEY_ACME=

# --- Mock / white-labeled tenant configuration ------------------------------
# These drive the Voicerely billing layer (NOT Retell's underlying cost).
# Each is namespaced by CLIENT_ID_UPPERCASE and falls back to the defaults
# shown on the right when omitted.
#
# RETELL_API_KEY_ACME must be set (or the global RETELL_API_KEY) for "acme".

# VOICERELY_NAME_ACME=Acme Communications
# VOICERELY_PLAN_ACME=fixed_allowance        # pay_as_you_go | fixed_allowance | tiered
# VOICERELY_RATE_ACME=0.18                    # Voicerely per-minute rate (USD), e.g. 0.18
# VOICERELY_MINUTES_ACME=5000                # null/blank = unlimited (pure PAYG)
# VOICERELY_CURRENCY_ACME=USD                # USD | EUR | GBP
# VOICERELY_CYCLE_START_ACME=2026-07-01      # ISO date of billing cycle start

# Example second tenant (repeat the pattern for each client):
# RETELL_API_KEY_GLOBEX=
# VOICERELY_NAME_GLOBEX=Globex Industries
# VOICERELY_PLAN_GLOBEX=tiered
# VOICERELY_RATE_GLOBEX=0.15
# VOICERELY_MINUTES_GLOBEX=
# VOICERELY_CURRENCY_GLOBEX=EUR
# VOICERELY_CYCLE_START_GLOBEX=2026-07-01

# -----------------------------------------------------------------------------
# DATA LAYER (Prisma + PostgreSQL production driver)
# -----------------------------------------------------------------------------
# DATA_DRIVER selects the active tenant repository backend:
#   "json"     (default) -> flat-file JSON store (lib/db.ts) — dev / no DB needed
#   "postgres"          -> Prisma + PostgreSQL (lib/repositories/tenantPostgresRepository.ts)
# Flip this one flag to switch the entire data layer; no code changes required.
DATA_DRIVER=json

# PostgreSQL connection string used by Prisma (required only when DATA_DRIVER=postgres).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The connection is pooled via a pg.Pool (max 10) and cached as a singleton to
# avoid exhausting connections during Next.js hot reloads.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicerely?schema=public

# --- Paddle Billing (server-only) -------------------------------------------
# Paddle API key for payment method management and checkout sessions.
# Get from: https://vendors.paddle.com/settings/developer-tools/api-keys
PADDLE_API_KEY=

# Paddle Vendor ID (found in Paddle dashboard settings)
PADDLE_VENDOR_ID=

# Paddle Price ID for setup/update payment method (create a $0 product in Paddle)
PADDLE_SETUP_PRICE_ID=

# Public app URL used for Paddle checkout return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paddle Environment: "sandbox" or "production"
PADDLE_ENV=sandbox

# Public Paddle Setup Price ID (exposed to client for Paddle.js SDK)
NEXT_PUBLIC_PADDLE_SETUP_PRICE_ID=

# Public Paddle Client Token (exposed to client for Paddle.js SDK init)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Public Paddle Environment (exposed to client; must match PADDLE_ENV above)
# "sandbox" or "production"
NEXT_PUBLIC_PADDLE_ENV=sandbox

# --- SMTP / Email (server-only, used by lib/email.ts) ----------------
# When these are unset the app runs in "preview" mode: onboarding emails
# are logged to the server console instead of being sent. Configure a real
# SMTP server (or a relay like Mailtrap / SendGrid / Postmark) to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Display "From" address for outbound notifications.
SMTP_FROM=Voicerely <no-reply@voicerely.app>
